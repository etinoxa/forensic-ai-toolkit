# FAIT logging
FAIT_LOG_LEVEL=INFO
FAIT_LOGS_DIR=.fait/logs
FAIT_LOG_JSON_CONSOLE=false
FAIT_LOG_MAX_BYTES=52428800   # 50 MB
FAIT_LOG_BACKUPS=14

# Centralized paths (leave unset to use defaults under .fait/)
# FAIT_HOME=
# FAIT_OUTPUTS_DIR=.fait/outputs
# FAIT_LOGS_DIR=.fait/logs
# FAIT_CACHE_DIR=.fait/cache
# FAIT_MODELS_CACHE_DIR=.fait/cache/models
# FAIT_EMBEDDINGS_CACHE_DIR=.fait/cache/models

# Object screening closed-set verifier:
FAIT_OBJECT_STRATEGY=two_stage        # gdino_only or detector_only | two_stage #   two_stage = grounding-dino + yolo | deformable_detr
FAIT_OBJECT_VERIFIER=yolo               # used in  two_stage or detector_only = yolo | deformable_detr | none

# Audio
#FAIT_AUDIO_EMBEDDER=speechbrain #resemblyzer # speechbrain
#FAIT_AUDIO_EMBEDDINGS_MODEL=resemblyzer

# strategy selection
FAIT_AUDIO_STRATEGY=two_stage           # speechbrain_only | titanet_only | two_stage | three_stage | detector_only | auto
FAIT_AUDIO_DETECTOR=titanet           # titanet | wavlm | none | auto
FAIT_AUDIO_TERTIARY=none           # titanet | wavlm | none | auto

# fusion knobs (optional central override if you want)
FAIT_AUDIO_ALPHA=0.60
FAIT_AUDIO_TAU=0.70
FAIT_PROGRESS=log

#FAIT_AUDIO_RESNET_ID=speechbrain/spkrec-resnet-voxceleb



SPEECHBRAIN_LOCAL_FILES_STRATEGY=copy
HF_HUB_DISABLE_SYMLINKS_WARNING=1



# LLM provider settings
FAIT_LLM_ID=Qwen/Qwen2.5-0.5B-Instruct

# Tensorflow Warning Suppression
TF_CPP_MIN_LOG_LEVEL=3  # 0=all, 1=INFO off, 2=+WARNING off, 3=+ERROR off (keep only FATAL)
TF_ENABLE_ONEDNN_OPTS=0


# OCR
# STRATEGY = first_nonempty | best_of | consensus | two_stage | detector_only
# VERIFIERS = none | paddle | tesseract | trocr | donut | doctr
# ENGINES = comma-separated list of models to use in order of preference. paddle,tesseract,trocr,donut,doctr
#use:
# if STRATEGY = first_nonempty | best_of | consensus, VERIFIER = none, ENGINES = paddle &| tesseract | trocr | donut | doctr
# if STRATEGY = two_stage, VERIFIER = tesseract | trocr | donut | doctr
# if STRATEGY = detector_only, VERIFIER =  paddle | tesseract | trocr | donut | doctr

FAIT_OCR_STRATEGY=first_nonempty
FAIT_OCR_VERIFIER=none
FAIT_OCR_ENGINES=trocr
#FAIT_OCR_ENGINES=paddle,tesseract,trocr,donut,doctr


# Core
#FAIT_OCR_GALLERY_DIR=/abs/path/to/images
#FAIT_OCR_OUTPUT_DIR=/abs/path/to/output

FAIT_OCR_LANGS=en
FAIT_OCR_MIN_KB=10
FAIT_OCR_MIN_WIDTH=100
FAIT_OCR_MIN_HEIGHT=100
FAIT_OCR_ROTATIONS=0,90,180,270

# Engine-specific
FAIT_OCR_TESSERACT_LANG=eng
FAIT_OCR_TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
FAIT_OCR_TESSERACT_PSM=3
FAIT_OCR_TESSERACT_OEM=3
TESSDATA_PREFIX="C:\\Program Files\\Tesseract-OCR\\tessdata"



FAIT_OCR_PADDLE_LANG=en
# microsoft/trocr-base-printed | microsoft/trocr-large-printed
FAIT_OCR_TROCR_MODEL=microsoft/trocr-large-printed
FAIT_OCR_DONUT_MODEL=naver-clova-ix/donut-base
FAIT_OCR_DOCTR_DET=db_resnet50
FAIT_OCR_DOCTR_RECO=crnn_vgg16_bn
